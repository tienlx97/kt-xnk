{
  "name": "kt-xnk-template",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSpec x Harness Engineering project. Next.js (App Router, JavaScript) + StyleX.",
  "scripts": {
    "audit": "./harness/audit-harness.sh",
    "build": "pnpm theme:build && next build",
    "dev": "pnpm theme:build && next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "next start",
    "structure": "depcruise src --config harness/structure.rules.cjs",
    "test": "node --test 'src/**/*.test.js'",
    "test:harness": "node --test harness/tests/*.test.cjs",
    "theme:build": "astryx theme build src/shared/components/theme.js -o src/shared/components/theme.built.css",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "verify": "./harness/verify.sh",
    "verify:quality": "node harness/checks/quality.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.3.0",
    "@astryxdesign/theme-neutral": "^0.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@stylexjs/stylex": "^0.15.0",
    "@tanstack/react-query": "^5.101.4",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-flexible-toc": "^1.2.6",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.3.0",
    "@eslint/js": "^9.18.0",
    "@stylexjs/babel-plugin": "^0.15.0",
    "@stylexjs/eslint-plugin": "^0.15.0",
    "@stylexjs/postcss-plugin": "^0.15.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-package-json": "^1.6.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=10"
  }
}
